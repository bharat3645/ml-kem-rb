{"version": 2, "width": 80, "height": 24, "timestamp": 1786994317, "env": {"SHELL": "/bin/bash", "TERM": "linux"}, "title": "ml-kem-rb: ML-KEM-768 + implicit rejection + X25519 hybrid"}
[0.010119, "o", "$ irb -Ilib\r\n"]
[0.914922, "o", "Switch to inspect mode.\r\n"]
[0.914999, "o", "\r\nrequire './lib/ml_kem'; nil\r\n"]
[0.921391, "o", "\r\n"]
[1.117604, "o", "kem = MLKem::KEM.new(768); nil\r\n"]
[1.11816, "o", "\r\n"]
[1.720098, "o", "ek, dk = kem.keygen; nil\r\n"]
[1.769503, "o", "\r\n"]
[2.12245, "o", "puts \"ek: #{ek.bytesize} bytes, dk: #{dk.bytesize} bytes\"\r\n"]
[2.12345, "o", "ek: 1184 bytes, dk: 2400 bytes\r\n\r\n"]
[3.324825, "o", "shared_secret, ciphertext = kem.encaps(ek); nil\r\n"]
[3.370646, "o", "\r\n"]
[3.727033, "o", "puts \"ciphertext: #{ciphertext.bytesize} bytes\"\r\n"]
[3.727625, "o", "ciphertext: 1088 bytes\r\n\r\n"]
[4.729769, "o", "shared_secret2 = kem.decaps(dk, ciphertext); nil\r\n"]
[4.794399, "o", "\r\n"]
[5.132605, "o", "puts \"shared secrets match: #{shared_secret == shared_secret2}\"\r\n"]
[5.133133, "o", "shared secrets match: true\r\n\r\n"]
[6.135038, "o", "puts \"shared secret (hex): #{shared_secret.unpack1(%(H*))}\"\r\n"]
[6.135654, "o", "shared secret (hex): df4d07ef91f0259cd5fe0f487d8d44f39a9ff4afc396a4ad6d6cb4f68c9d45e2\r\n\r\n"]
[7.637242, "o", "tampered = ciphertext.dup; tampered[0] = (tampered.getbyte(0) ^ 0xFF).chr; nil\r\n"]
[7.638009, "o", "\r\n"]
[8.139687, "o", "rejected = kem.decaps(dk, tampered); nil\r\n"]
[8.191466, "o", "\r\n"]
[8.641942, "o", "puts \"tampered ciphertext -- no exception, implicit rejection gives a different secret: #{rejected != shared_secret}\"\r\n"]
[8.642537, "o", "tampered ciphertext -- no exception, implicit rejection gives a different secret: true\r\n\r\n"]
[10.444561, "o", "require './lib/ml_kem/hybrid'; nil\r\n"]
[10.492166, "o", "\r\n"]
[10.94665, "o", "puts \"Hybrid.available? #{MLKem::Hybrid.available?}\"\r\n"]
[10.948526, "o", "Hybrid.available? true\r\n\r\n"]
[12.148921, "o", "client_share, state = MLKem::Hybrid.client_init; nil\r\n"]
[12.198559, "o", "\r\n"]
[12.551053, "o", "puts \"client_share (X25519 pk + ML-KEM-768 ek): #{client_share.bytesize} bytes\"\r\n"]
[12.551807, "o", "client_share (X25519 pk + ML-KEM-768 ek): 1216 bytes\r\n\r\n"]
[13.553642, "o", "server_share, server_secret = MLKem::Hybrid.server_respond(client_share); nil\r\n"]
[13.593466, "o", "\r\n"]
[14.055988, "o", "puts \"server_share: #{server_share.bytesize} bytes\"\r\n"]
[14.056639, "o", "server_share: 1120 bytes\r\n\r\n"]
[15.058147, "o", "client_secret = MLKem::Hybrid.client_finish(state, server_share); nil\r\n"]
[15.110207, "o", "\r\n"]
[15.560551, "o", "puts \"hybrid secrets match: #{client_secret == server_secret}, #{client_secret.bytesize} bytes (ss_mlkem || x25519_ss)\"\r\n"]
[15.561032, "o", "hybrid secrets match: true, 64 bytes (ss_mlkem || x25519_ss)\r\n"]
[15.561078, "o", "\r\n"]
[17.562646, "o", "exit\r\n"]
